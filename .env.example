# Only used for local dev. Production values live as Fly secrets.

PORT=2567

# From Firebase Console -> Project settings -> Service accounts ->
# "Generate new private key" -> downloaded JSON file.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# IMPORTANT: keep the surrounding double quotes and the literal \n escapes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...your...key...here...\n-----END PRIVATE KEY-----\n"
